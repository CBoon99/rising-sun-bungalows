<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ settings.seo.title }}</title>
    <meta name="description" content="{{ settings.seo.description }}">
    <meta name="keywords" content="{{ settings.seo.keywords }}">
    <meta name="author" content="{{ settings.business_name }}">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="googlebot" content="index, follow">
    <meta name="bingbot" content="index, follow">
    <meta name="theme-color" content="#5e6f5a">
    <meta name="color-scheme" content="light dark">
    <meta name="format-detection" content="telephone=no">
    <meta name="geo.region" content="ID-NB">
    <meta name="geo.placename" content="{{ settings.geo.locality }}, Lombok">
    <meta name="geo.position" content="{{ settings.geo.lat }};{{ settings.geo.lng }}">
    <meta name="ICBM" content="{{ settings.geo.lat }}, {{ settings.geo.lng }}">
    <meta name="language" content="English">
    <meta name="revisit-after" content="7 days">
    <meta name="rating" content="general">
    <link rel="canonical" href="{{ settings.site_url }}/">
    <link rel="alternate" hreflang="en" href="{{ settings.site_url }}/">
    <link rel="alternate" hreflang="x-default" href="{{ settings.site_url }}/">
    <link rel="sitemap" type="application/xml" href="/sitemap.xml">
    <link rel="author" href="/humans.txt">
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM facts">
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM full facts">
    <link rel="me" href="{{ settings.instagram_url }}">
    <link rel="manifest" href="/site.webmanifest">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ settings.business_name }}">
    <meta property="og:locale" content="en_US">
    <meta property="og:url" content="{{ settings.site_url }}/">
    <meta property="og:title" content="{{ settings.seo.og_title }}">
    <meta property="og:description" content="{{ settings.seo.og_description }}">
    <meta property="og:image" content="{{ settings.seo.og_image | abs(settings.site_url) }}">
    <meta property="og:image:secure_url" content="{{ settings.seo.og_image | abs(settings.site_url) }}">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ settings.seo.og_image_alt }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ settings.seo.twitter_title }}">
    <meta name="twitter:description" content="{{ settings.seo.twitter_description }}">
    <meta name="twitter:image" content="{{ settings.seo.og_image | abs(settings.site_url) }}">
    <meta name="twitter:image:alt" content="{{ settings.seo.og_image_alt }}">

    <link rel="icon" href="/assets/favicon.ico" sizes="any">
    <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
    <link rel="mask-icon" href="/assets/logo.svg" color="#8a6814">
    <meta name="msapplication-TileColor" content="#115e59">
    <meta name="msapplication-config" content="/browserconfig.xml">

    <script type="application/ld+json">{{ jsonld | json | safe }}</script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet"></noscript>
    <link rel="stylesheet" href="/css/site.css">
    <link rel="preload" as="image" type="image/webp" href="{{ home.hero.image | w800 | towebp }}" imagesrcset="{{ home.hero.image | w800 | towebp }} 800w, {{ home.hero.image | towebp }} {{ home.hero.image | imgw }}w" imagesizes="100vw" fetchpriority="high">
    <script>
      (function () {
        try {
          var t = localStorage.getItem('rsb-theme');
          if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <a class="skip-link" href="#book">Skip to booking</a>
    <nav class="nav" aria-label="Primary">
        <div class="nav-inner">
            <a href="/" class="brand" aria-label="{{ settings.business_name }} — Home">
                <span class="brand-mark" aria-hidden="true">{{ settings.brand_mark }}</span>
                <div class="brand-text">
                    <small>{{ settings.place_short }}</small>
                    <strong>{{ settings.short_name }}</strong> <span>{{ settings.product_name }}</span>
                </div>
            </a>
            <div class="nav-links" role="list">
                {% for item in settings.nav.items %}
                {% if item.href != "#book" %}
                <a role="listitem" href="{{ item.href }}">{{ item.label }}</a>
                {% endif %}
                {% endfor %}
            </div>
            <div class="nav-actions">
                <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle light and dark mode" title="Toggle theme" aria-pressed="false">
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 14.5A8.5 8.5 0 1 1 9.5 3a7 7 0 0 0 11.5 11.5z"/></svg>
                </button>
                <a href="#book" class="btn btn-primary">{{ settings.nav.book_label }}</a>
                <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="menu-drawer">
                    <svg class="icon-burger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                    <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
            </div>
        </div>
    </nav>

    <div class="menu-drawer" id="menu-drawer" aria-hidden="true">
        <button type="button" class="menu-backdrop" id="menu-backdrop" aria-label="Close menu"></button>
        <nav class="menu-panel" aria-label="Site sections">
            {% for item in settings.nav.items %}
            <a href="{{ item.href }}">{{ item.label }}</a>
            {% endfor %}
            <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener noreferrer">Instagram</a>
            <a href="https://wa.me/{{ settings.whatsapp }}" target="_blank" rel="noopener noreferrer">WhatsApp</a>
            <a href="#book" class="btn btn-primary menu-cta">{{ settings.nav.menu_cta }}</a>
            <p class="menu-meta">{{ settings.nav.menu_meta }}</p>
        </nav>
    </div>

    <main id="main">
    <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
            <li><a href="/">Home</a></li>
            <li><a href="#bungalows">Stay</a></li>
            <li><a href="#get-there">How to get to Gili Meno</a></li>
            <li><a href="#faq">FAQ</a></li>
            <li><a href="#book">Book</a></li>
        </ol>
    </nav>
    <section class="hero" aria-label="{{ settings.business_name }}, {{ settings.geo.locality }}">
        {% set src = home.hero.image %}
        {% set alt = home.hero.image_alt %}
        {% set wrapClass = "hero-picture" %}
        {% set imgClass = "hero-photo" %}
        {% set id = "heroImg" %}
        {% set fetchpriority = "high" %}
        {% set sizes = "100vw" %}
        {% include "picture.njk" %}
        <div class="hero-overlay" aria-hidden="true"></div>
        <canvas id="hero-canvas" aria-hidden="true"></canvas>
        <div class="hero-inner">
            <div class="hero-brand fade-up">
                <h1 class="hero-title">
                    <span class="hero-wordmark">{{ home.hero.wordmark }}</span>
                    <span class="hero-product">{{ home.hero.product }}</span>
                </h1>
                <p class="hero-place">{{ home.hero.place }}</p>
            </div>
            <div class="hero-copy fade-up">
                <p class="hero-tagline">{{ home.hero.tagline | nl2br | safe }}</p>
                <p class="hero-lead">{{ home.hero.lead }}</p>
                <div class="hero-actions">
                    <a href="#book" class="btn btn-on-dark">{{ home.hero.cta_primary_label }}</a>
                    <a href="#long-stay" class="btn btn-outline-light">{{ home.hero.cta_secondary_label }}</a>
                </div>
            </div>
        </div>
    </section>

    <section class="stats" aria-label="Key facts">
        <div class="wrap stats-grid">
            {% for stat in home.stats %}
            <div class="fade-up"><div class="stat-value">{{ stat.value }}</div><div class="stat-label">{{ stat.label }}</div></div>
            {% endfor %}
        </div>
    </section>

    <section id="bungalows" class="section">
        <div class="wrap">
            <div class="grid-2 mb-14">
                <div class="fade-up">
                    <p class="eyebrow mb-3">{{ home.stay.eyebrow }}</p>
                    <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.5rem);margin:0 0 1.25rem">{{ home.stay.heading | nl2br | safe }}</h2>
                    <p class="muted leading-relaxed mb-6">{{ home.stay.body }}</p>
                    <h3 class="eyebrow" style="margin:0 0 0.5rem">What’s included in each bungalow</h3>
                    <h4 class="mono" style="margin:0 0 0.35rem">Nightly rate</h4>
                    <div class="mb-8"><span class="price">{{ settings.nightly_price_display }}</span><small>{{ home.stay.price_suffix }}</small></div>
                    <ul class="amenity-row">
                        {% for amenity in settings.amenities %}
                        <li>{{ amenity }}</li>
                        {% endfor %}
                    </ul>
                    <h5 class="faint" style="font-size:0.85rem;margin:0 0 1.5rem;font-weight:500">Check-in {{ settings.checkin }} · Check-out {{ settings.checkout }}</h5>
                    <a href="#book" class="btn btn-ghost">{{ home.stay.cta_label }}</a>
                </div>
                <div class="img-grid-2 fade-up">
                    {% set wrapClass = "" %}
                    {% set imgClass = "" %}
                    {% set id = false %}
                    {% set fetchpriority = false %}
                    {% set sizes = "(max-width: 800px) 100vw, 50vw" %}
                    {% for photo in home.stay.photos %}
                    {% set src = photo.image %}
                    {% set alt = photo.alt %}
                    {% include "picture.njk" %}
                    {% endfor %}
                </div>
            </div>
            <div class="gallery fade-up">
                {% set sizes = "(max-width: 800px) 100vw, 33vw" %}
                {% for photo in home.stay.gallery %}
                {% set src = photo.image %}
                {% set alt = photo.alt %}
                {% set wrapClass = "span-2" if photo.wide else "" %}
                {% include "picture.njk" %}
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="long-stay" class="section section-muted">
        <div class="wrap grid-2">
            <div class="fade-up order-2 md-order-1">
                <p class="eyebrow mb-3">{{ home.long_stay.eyebrow }}</p>
                <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.5rem);margin:0 0 1.25rem">{{ home.long_stay.heading | nl2br | safe }}</h2>
                <p class="muted leading-relaxed mb-6">{{ home.long_stay.body }}</p>
                <h3 class="eyebrow">What’s included on a monthly Gili Meno stay</h3>
                <ul class="check-list">
                    {% for bullet in home.long_stay.bullets %}
                    <li>{{ bullet }}</li>
                    {% endfor %}
                </ul>
                <div class="flex-wrap">
                    <a href="#book" class="btn btn-primary">{{ home.long_stay.cta_primary_label }}</a>
                    <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">{{ home.long_stay.cta_secondary_label }}</a>
                </div>
            </div>
            <div class="fade-up order-1 md-order-2 relative">
                <div class="media-frame h-420">
                    {% set src = home.long_stay.image %}
                    {% set alt = home.long_stay.image_alt %}
                    {% set wrapClass = "" %}
                    {% set sizes = "(max-width: 800px) 100vw, 50vw" %}
                    {% include "picture.njk" %}
                </div>
                <div class="glass-panel pill-float">
                    <p class="mono mb-2">{{ home.long_stay.pill_label }}</p>
                    <p class="display" style="font-size:1.4rem;margin:0">{{ home.long_stay.pill_title }}</p>
                    <p class="faint" style="font-size:0.85rem;margin:0.35rem 0 0">{{ home.long_stay.pill_note }} · {{ settings.reply_window }}</p>
                </div>
            </div>
        </div>
    </section>

    <section id="cafe" class="section section-border">
        <div class="wrap grid-2">
            <div class="fade-up relative">
                <div class="media-frame h-420">
                    {% set src = home.cafe.image %}
                    {% set alt = home.cafe.image_alt %}
                    {% set wrapClass = "" %}
                    {% set sizes = "(max-width: 800px) 100vw, 50vw" %}
                    {% include "picture.njk" %}
                </div>
                {% if home.cafe.show_badge %}
                <span class="badge chip">{{ home.cafe.badge }}</span>
                {% endif %}
            </div>
            <div class="fade-up">
                <p class="eyebrow mb-3" style="color:var(--gold)">{{ home.cafe.eyebrow }}</p>
                <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.5rem);margin:0 0 1.25rem">{{ home.cafe.heading }}</h2>
                {% if home.cafe.show_badge %}
                <h3 class="mono mb-3" style="color:var(--gold)">{{ home.cafe.badge }}</h3>
                {% endif %}
                <p class="muted leading-relaxed mb-6">{{ home.cafe.body }}</p>
                {% if home.cafe.menu %}
                <div class="muted leading-relaxed mb-6 cafe-menu">{{ home.cafe.menu | md | safe }}</div>
                {% endif %}
                <p class="faint mb-8" style="font-size:0.9rem">{{ home.cafe.note }}</p>
                <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">{{ home.cafe.cta_label }}</a>
            </div>
        </div>
    </section>

    <section id="island" class="section section-muted">
        <div class="wrap">
            <div class="text-center max-w-2xl mx-auto mb-14 fade-up">
                <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.5rem);margin:0 0 1.25rem">{{ home.island.heading }}</h2>
                <p class="muted leading-relaxed">{{ home.island.intro }}</p>
            </div>
            <div class="grid-3 mb-12">
                {% for feature in home.island.features %}
                <article class="card fade-up">
                    <div class="feature-icon" aria-hidden="true">
                        {% if feature.icon == "turtle" %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 14c2-1 4-1 6 0s4 1 6 0 4-1 4-1"/><path d="M3 18c3-2 6-2 9 0s6 2 9 0"/><circle cx="12" cy="9" r="3"/></svg>
                        {% elif feature.icon == "wall" %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 8h16M4 12h10M4 16h14"/><circle cx="18" cy="16" r="2"/></svg>
                        {% else %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 5v2M12 17v2M5 12h2M17 12h2"/></svg>
                        {% endif %}
                    </div>
                    <h3 class="display" style="font-size:1.35rem;margin:0 0 0.6rem">{{ feature.title }}</h3>
                    <p class="muted" style="font-size:0.95rem;line-height:1.6;margin:0">{{ feature.body }}</p>
                </article>
                {% endfor %}
            </div>
            <div class="grid-3">
                {% for card in home.island.cards %}
                <article class="card group fade-up" style="padding:0;overflow:hidden">
                    <div class="card-media aspect-43">
                        {% set src = card.image %}
                        {% set alt = card.alt %}
                        {% set wrapClass = "" %}
                        {% set sizes = "(max-width: 800px) 100vw, 33vw" %}
                        {% include "picture.njk" %}
                    </div>
                    <div style="padding:1.35rem 1.5rem 1.5rem">
                        <h3 class="display" style="font-size:1.2rem;margin:0 0 0.4rem">{{ card.title }}</h3>
                        <p class="muted" style="font-size:0.9rem;line-height:1.55;margin:0">{{ card.body }}</p>
                    </div>
                </article>
                {% endfor %}
            </div>
            <p class="text-center mt-12 fade-up">
                <a href="#get-there" class="btn btn-ghost">{{ home.island.cta_label }}</a>
            </p>
        </div>
    </section>

    <section id="diving" class="section">
        <div class="wrap grid-2">
            <div class="fade-up">
                <p class="eyebrow mb-3">{{ home.diving.eyebrow }}</p>
                <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.5rem);margin:0 0 1.25rem">{{ home.diving.heading | nl2br | safe }}</h2>
                <p class="muted leading-relaxed mb-6">{{ home.diving.body | mdi | safe }}</p>
                <h3 class="eyebrow">What Meno Dive Club offers</h3>
                <ul class="check-list">
                    {% for bullet in home.diving.bullets %}
                    <li>{{ bullet }}</li>
                    {% endfor %}
                </ul>
                <a href="{{ settings.dive_club_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-solid-accent">{{ home.diving.cta_label }}</a>
            </div>
            <div class="fade-up" style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem">
                <a href="{{ settings.dive_club_url }}" target="_blank" rel="noopener noreferrer" class="media-frame relative" style="grid-column:1/-1;aspect-ratio:16/10;display:block">
                    {% set src = home.diving.image_main %}
                    {% set alt = home.diving.image_main_alt %}
                    {% set wrapClass = "cover-abs" %}
                    {% set extra = 'style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"' %}
                    {% set sizes = "(max-width: 800px) 100vw, 50vw" %}
                    {% include "picture.njk" %}
                    <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(4,8,12,.85),transparent 55%)"></div>
                    <div style="position:absolute;left:1.5rem;right:1.5rem;bottom:1.35rem;color:#fff">
                        <h3 class="display" style="font-size:1.5rem;margin:0 0 0.25rem">{{ home.diving.overlay_title }}</h3>
                        <p style="margin:0;opacity:.85;font-size:.9rem">{{ home.diving.overlay_text }}</p>
                    </div>
                </a>
                <div class="media-frame" style="height:10rem">
                    {% set src = home.diving.image_pool %}
                    {% set alt = home.diving.image_pool_alt %}
                    {% set wrapClass = "" %}
                    {% set extra = "" %}
                    {% include "picture.njk" %}
                </div>
                <div class="media-frame" style="height:10rem">
                    {% set src = home.diving.image_fins %}
                    {% set alt = home.diving.image_fins_alt %}
                    {% include "picture.njk" %}
                </div>
            </div>
        </div>
    </section>

    <section id="get-there" class="section section-muted section-border">
        <div class="wrap">
            <div class="text-center max-w-2xl mx-auto mb-14 fade-up">
                <p class="eyebrow mb-3">{{ home.get_there.eyebrow }}</p>
                <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.5rem);margin:0 0 1.25rem">{{ home.get_there.heading }}</h2>
                <p class="muted leading-relaxed">{{ home.get_there.intro }}</p>
            </div>
            <div class="grid-4 mb-12">
                {% for route in home.get_there.routes %}
                <article class="card fade-up">
                    <p class="mono mb-3" style="color:var(--accent)">{{ route.kicker }}</p>
                    <h3 class="display" style="font-size:1.35rem;margin:0 0 0.6rem">{{ route.title }}</h3>
                    <p class="muted" style="font-size:0.9rem;line-height:1.55;margin:0">{{ route.body }}</p>
                </article>
                {% endfor %}
            </div>
            <div class="grid-2">
                <div class="fade-up">
                    <h4 class="display" style="font-size:1.5rem;margin:0 0 1.25rem">{{ home.get_there.landing_heading }}</h4>
                    {% for step in home.get_there.steps %}
                    <div class="stack-nums"><span class="num">{{ loop.index | pad2 }}</span><span>{{ step | mdi | safe }}</span></div>
                    {% endfor %}
                    <h5 class="faint mt-3" style="font-size:0.85rem;font-weight:500">{{ home.get_there.tip }}</h5>
                    <a href="#book" class="btn btn-primary mt-6">{{ home.get_there.cta_label }}</a>
                </div>
                <div class="fade-up">
                    <div id="map" role="region" aria-label="Map of Rising Sun Bungalows near Gili Meno harbour"></div>
                    <h5 class="faint text-center mt-3" style="font-size:0.85rem;font-weight:500">{{ home.get_there.map_caption }}</h5>
                </div>
            </div>
        </div>
    </section>

    <section id="faq" class="section">
        <div class="wrap" style="max-width:46rem">
            <div class="text-center mb-14 fade-up">
                <p class="eyebrow mb-3">Good to know</p>
                <h2 class="display" style="font-size:clamp(2.2rem,5vw,3.5rem);margin:0">Gili Meno bungalows — questions</h2>
            </div>
            <div class="faq-list">
                {% for item in faqs.items %}
                <article class="faq-item fade-up" id="{{ item.id }}">
                    <h3 class="display" style="font-size:1.25rem;margin:0 0 0.5rem">{{ item.question }}</h3>
                    <p class="muted" style="margin:0;line-height:1.65">{{ item.answer }}</p>
                </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="book" class="section book">
        <div class="wrap text-center" style="max-width:42rem">
            <h2 class="display fade-up" style="font-size:clamp(2.2rem,5vw,3.5rem);margin:0 0 1rem;color:#f5f7fa">{{ home.book.heading }}</h2>
            <p class="fade-up book-lead">{{ home.book.lead }}</p>
            <p class="fade-up book-note">{{ home.book.note }}</p>
            <form name="booking" method="POST" action="/thank-you.html" data-netlify="true" netlify-honeypot="bot-field" class="form-card fade-up">
                <input type="hidden" name="form-name" value="booking">
                <p class="hidden" style="display:none"><label>Leave blank <input name="bot-field"></label></p>
                <div class="form-grid cols-2">
                    <div>
                        <label for="check-in">Check-in</label>
                        <input id="check-in" type="date" name="check-in" required>
                    </div>
                    <div>
                        <label for="check-out">Check-out</label>
                        <input id="check-out" type="date" name="check-out" required>
                    </div>
                </div>
                <div class="form-grid cols-2">
                    <div>
                        <label for="guest-name">Name</label>
                        <input id="guest-name" type="text" name="guest-name" required autocomplete="name" placeholder="Your name">
                    </div>
                    <div>
                        <label for="email">Email</label>
                        <input id="email" type="email" name="email" required autocomplete="email" placeholder="you@email.com">
                    </div>
                </div>
                <div class="form-grid cols-2">
                    <div>
                        <label for="phone">WhatsApp / phone (optional)</label>
                        <input id="phone" type="tel" name="phone" autocomplete="tel" placeholder="+62 …">
                    </div>
                    <div>
                        <label for="guests">Guests (optional)</label>
                        <input id="guests" type="number" name="guests" min="1" max="12" placeholder="2">
                    </div>
                </div>
                <div class="form-grid">
                    <div>
                        <label for="stay-type">Stay type</label>
                        <select id="stay-type" name="stay-type">
                            {% for type in home.book.stay_types %}
                            <option value="{{ type.value }}">{{ type.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="form-grid">
                    <div>
                        <label for="message">Message</label>
                        <textarea id="message" name="message" rows="4" placeholder="{{ home.book.message_placeholder }}"></textarea>
                    </div>
                </div>
                <p class="form-error" id="date-error" hidden tabindex="-1">Please choose a check-out date after check-in.</p>
                <button type="submit" class="btn btn-solid-accent w-full">{{ home.book.submit_label }}</button>
                <p class="faint text-center mt-3" style="font-size:0.75rem">{{ home.book.form_footnote }}</p>
            </form>
        </div>
    </section>
    </main>

    <div class="wa-float">
        <a href="https://wa.me/{{ settings.whatsapp }}?text={{ settings.whatsapp_message | urlencode }}"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Message {{ settings.business_name }} on WhatsApp">
            <span class="wa-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.86 11.86 0 0 0 12.06 0C5.5 0 .2 5.3.2 11.84c0 2.09.55 4.12 1.6 5.92L0 24l6.4-1.67a11.9 11.9 0 0 0 5.66 1.44h.01c6.55 0 11.86-5.3 11.86-11.84 0-3.16-1.23-6.13-3.41-8.45zM12.07 21.3h-.01a9.46 9.46 0 0 1-4.82-1.32l-.35-.2-3.8 1 1.01-3.7-.23-.38a9.4 9.4 0 0 1-1.44-5.01c0-5.2 4.24-9.43 9.46-9.43 2.52 0 4.9.98 6.68 2.77a9.37 9.37 0 0 1 2.77 6.67c0 5.2-4.24 9.43-9.47 9.43zm5.2-7.07c-.28-.14-1.68-.83-1.94-.92-.26-.1-.45-.14-.64.14-.19.28-.74.92-.9 1.11-.17.19-.33.21-.61.07-.28-.14-1.19-.44-2.27-1.4-.84-.75-1.41-1.67-1.57-1.95-.17-.28-.02-.43.12-.57.13-.13.28-.33.42-.5.14-.17.19-.28.28-.47.1-.19.05-.35-.02-.5-.07-.14-.64-1.54-.88-2.11-.23-.55-.47-.48-.64-.48h-.55c-.19 0-.5.07-.76.35-.26.28-1 1-1 2.43s1.02 2.82 1.17 3.01c.14.19 2 3.05 4.85 4.28.68.29 1.21.47 1.62.6.68.21 1.3.18 1.79.11.55-.08 1.68-.69 1.92-1.35.24-.66.24-1.23.17-1.35-.07-.11-.26-.18-.54-.32z"/></svg>
            </span>
            <span class="wa-label">WhatsApp</span>
        </a>
    </div>

    <footer class="footer">
        <div class="wrap">
            <div class="footer-top">
                <div class="brand">
                    <span class="brand-mark" aria-hidden="true">{{ settings.brand_mark }}</span>
                    <div class="brand-text">
                        <strong>{{ settings.short_name }}</strong> <span>{{ settings.product_name }}</span>
                        <p class="muted" style="font-size:0.85rem;margin:0.35rem 0 0;font-family:var(--font-body);letter-spacing:0;text-transform:none">{{ settings.location_line }}</p>
                        <p class="faint" style="font-size:0.75rem;margin:0.25rem 0 0;font-family:var(--font-body);letter-spacing:0;text-transform:none">Partner with <a class="link-accent" href="{{ settings.operator_url or settings.dive_club_url }}" target="_blank" rel="noopener noreferrer">{{ settings.operator_name or settings.dive_club_name }}</a></p>
                    </div>
                </div>
                <address class="footer-nap">
                    Rising Sun Bungalows<br>
                    Near Gili Meno harbour, Gili Meno, Lombok, Indonesia<br>
                    Partner with <a href="{{ settings.dive_club_url }}" target="_blank" rel="noopener noreferrer">Meno Dive Club</a><br>
                    {% if settings.contact_email %}<a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a><br>{% endif %}
                    <a href="https://wa.me/{{ settings.whatsapp }}">WhatsApp{% if settings.whatsapp_contact_name %} {{ settings.whatsapp_contact_name }}{% endif %} {{ settings.whatsapp_display or ("+" + settings.whatsapp) }}</a>
                </address>
                <div>
                    <div class="footer-links">
                        <a href="#get-there">How to get to Gili Meno</a>
                        {% if settings.contact_email %}
                        <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
                        {% endif %}
                        <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener noreferrer">Instagram</a>
                        <a href="{{ settings.google_search_url }}" target="_blank" rel="noopener noreferrer">Google</a>
                        <a href="{{ settings.dive_club_url }}" target="_blank" rel="noopener noreferrer">{{ settings.dive_club_name }}</a>
                    </div>
                    <p class="faint mt-3" style="font-size:0.8rem">© <span id="y"></span> {{ settings.business_name }}</p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>Developed by <a href="{{ settings.developer_url }}" target="_blank" rel="noopener noreferrer">{{ settings.developer_name }}</a></p>
            </div>
        </div>
    </footer>

    <script>
      window.__RSB = {
        lat: {{ settings.geo.lat }},
        lng: {{ settings.geo.lng }},
        name: {{ settings.business_name | json | safe }},
        map_popup: {{ settings.map_popup | json | safe }},
        harbour_popup: {{ settings.harbour_popup | json | safe }}
      };
    </script>
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script defer src="/js/app.js"></script>
</body>
</html>
