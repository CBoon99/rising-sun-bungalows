---
permalink: /thank-you.html
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ thanks.title }}</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="description" content="{{ thanks.description }}">
    <link rel="canonical" href="{{ settings.site_url }}/thank-you.html">
    <link rel="icon" href="/assets/favicon.ico" sizes="any">
    <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
    <meta name="theme-color" content="#5e6f5a">
    <meta name="color-scheme" content="light dark">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/site.css">
    <script>
      (function () {
        try {
          var t = localStorage.getItem('rsb-theme');
          if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
    <style>
      .thanks {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.5rem;
        text-align: center;
      }
      .thanks h1 {
        font-size: clamp(2.5rem, 6vw, 3.5rem);
        margin: 0 0 1rem;
      }
      .thanks p {
        max-width: 28rem;
        color: var(--text-muted);
        line-height: 1.65;
        margin: 0 0 2rem;
      }
    </style>
</head>
<body>
    <div class="thanks">
        <div class="brand" style="margin-bottom:2rem;justify-content:center">
            <span class="brand-mark" aria-hidden="true">{{ settings.brand_mark }}</span>
            <div class="brand-text">
                <small>{{ settings.place_short }}</small>
                <strong>{{ settings.short_name }}</strong> <span>{{ settings.product_name }}</span>
            </div>
        </div>
        <h1 class="display">{{ thanks.heading }}</h1>
        <p>{{ thanks.body | mdi | safe }}</p>
        <div class="flex-wrap" style="justify-content:center">
            <a href="/" class="btn btn-primary">{{ thanks.back_label }}</a>
            <a class="btn btn-ghost" href="https://wa.me/{{ settings.whatsapp }}?text={{ settings.whatsapp_message | urlencode }}" target="_blank" rel="noopener noreferrer">WhatsApp us</a>
        </div>
        <p class="faint" style="margin-top:3rem;font-size:0.75rem">Developed by <a class="link-accent" href="{{ settings.developer_url }}" target="_blank" rel="noopener noreferrer">{{ settings.developer_name }}</a></p>
    </div>
</body>
</html>
