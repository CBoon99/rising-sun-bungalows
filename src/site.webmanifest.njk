---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": {{ settings.business_name | json | safe }},
  "short_name": {{ settings.short_name | json | safe }},
  "description": {{ settings.seo.description | json | safe }},
  "start_url": "/",
  "display": "standalone",
  "background_color": "#fafaf9",
  "theme_color": "#115e59",
  "lang": "en",
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
